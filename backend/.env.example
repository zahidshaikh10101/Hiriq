# Copy to .env and fill in. Never commit .env.

# ---- Database (Neon free Postgres) ----
# Neon console -> your project -> Connect -> copy the connection string.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require

# ---- Tokens ----
# 32+ random characters:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
SESSION_HOURS=8

# ---- First admin (used only by:  python -m app.db.seed_admin) ----
ADMIN_USERNAME=admin
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=
ADMIN_NAME=Platform admin

# ---- Google sign-in ----
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web).
# Same value goes in frontend/assets/js/config.js as googleClientId.
GOOGLE_CLIENT_ID=

# ---- Email verification codes ----
# console = prints the code in the server log (free, development only)
# smtp    = real email. Free option: a Gmail "app password" (Google Account -> Security -> 2-Step
#           Verification -> App passwords). Put the 16-character app password in SMTP_PASSWORD.
EMAIL_PROVIDER=console
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ---- CORS ----
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5500,http://127.0.0.1:5500

# ---- Outside job feed (optional; candidates' "Search outside jobs") ----
# "Jobs API" (jobs-api14, Indeed search) on RapidAPI; the free plan is small. Paste YOUR key here, in this file only.
# .env is never committed. Leave empty to keep the feature off.
RAPIDAPI_KEY=
# Two-letter country for searches, and how many searches the whole server may make a day.
EXTERNAL_COUNTRY=in
EXTERNAL_DAILY_CAP=100
