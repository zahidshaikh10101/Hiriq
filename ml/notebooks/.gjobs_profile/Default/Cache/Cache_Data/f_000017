ull,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,0]],"lPH4auelCYuqhvcP5redoQQ57":[[0,"https://www.foundit.in/job/data-analyst-ii-skan-ai-bengaluru-bangalore-48143855","jobs","fcc7ivRb5PFX5M","\u003cp\u003eWe are seeking a \u003cstrong\u003eTask Mining Data Analyst \u003c/strong\u003ewho combines strong programming, data wrangling, and visualization skills with a deep understanding of business processes. This role involves transforming raw task mining data into meaningful insights that drive operational efficiency, automation, and AI-enabled decision-making.\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003eIn this role, You will \u003c/strong\u003e\u003c/p\u003e\u003cp\u003e- work with large, complex, multi-application interaction datasets and build insightful analytics, dashboards that reveal how work actually gets done.\u003c/p\u003e\u003cp\u003e- be involved in building reproducible data pipelines for processing millions of events.\u003c/p\u003e\u003cp\u003e- create modular, well-structured scripts and reusable components for analytics.\u003c/p\u003e\u003cp\u003e- create high-quality visualizations and convert technical analysis into meaningful business themes\u003c/p\u003e\u003cp\u003e\u003c/p\u003e\u003cp\u003e\u003cstrong\u003eSkills\u003c/strong\u003e\u003c/p\u003e\u003cul\u003e\u003cli\u003e3–6 years of experience in data analysis, business process analysis, task mining or process mining.\u003c/li\u003e\u003cli\u003eStrong proficiency in SQL and Python/Pandas for data transformation and analysis (Pandas, NumPy, regex, data manipulation).\u003c/li\u003e\u003cli\u003eAbility to handle large data sets and work with structured and semi-structured event data\u003c/li\u003e\u003cli\u003eUnderstanding of enterprise workflows, multi-application work patterns, and human-in-the-loop processes is a plus\u003c/li\u003e\u003cli\u003eFamiliarity with ML techniques such as clustering, sequence alignment, pattern mining, or similar analytical methods.\u003c/li\u003e\u003cli\u003eExcellent communication skills with the ability to translate technical insights into clear business language.\u003c/li\u003e\u003cli\u003eStrong attention to detail and a passion for understanding how work truly gets done at scale.\u003c/li\u003e\u003c/ul\u003e","Data Analyst II",null,null,0,[["organization","Skan.ai"],["organization_mid","/g/11jdn6drnb"],["publisher_name","Foundit"],["location_feature_id","/google/oyster/feature/0x3bae1670c9b44e6d:0xf8dfc3e8517e4fe0"],["cluster_id","0x08a7185502a34026"]],0],[null,1,null,["organization","organization_mid","publisher_name","location_feature_id","cluster_id"],1,1,1],[null,0,null,["organization","organization_mid","publisher_name","location_feature_id","cluster_id"],1,1,1]],"lPH4auelCYuqhvcP5redoQQ58":[null,null,null,null,null,null,null,null,[[43911100,0.40079606,4]]],"lPH4auelCYuqhvcP5redoQQ75":[["https://www.google.com/search?ibp\u003dhtl;jobs\u0026q\u003dData+Analyst+in+Bengaluru+with+5+years+of+experience+jobs\u0026htidocid\u003d8eRb9Io7x30K4ymoAAAAAA%3D%3D\u0026hl\u003den-IN\u0026shem\u003depsd1,esd2e,rimspwouoe,sdpie\u0026shndl\u003d37\u0026shmd\u003dH4sIAAAAAAAA_xXNsQrCMBCAYVz7CC7eKCKJCC46KYIURx-gXENIauNdyF2hbo7uvqFPYl3-7eOv3rNqeUZFOBKmpyjUNXxfH7hzC-KxuAhMcGEOyc8PUTXL3lqRZIIoaueM44dl8i2PdkLyTyMRi88J1Tfb3WY0mcJqceuRDHbQEZw8BUxDGdZwxULTv8cfAV_QU4sAAAA\u0026shmds\u003dv1_Ac3VAozrMM3d8UtgpBf3l7CtN6CLoenpMrAMhwmhpqsTOLRTow\u0026source\u003dsh/x/job/uv/m5/1#fpstate\u003dtldetail\u0026htivrt\u003djobs\u0026htidocid\u003d8eRb9Io7x30K4ymoAAAAAA%3D%3D\u0026htiq\u003dData+Analyst+in+Bengaluru+with+5+years+of+experience+jobs",null,null,"Data Analyst II",null,null,null,null,1,null,37,["H4sIAAAAAAAA_xXNsQrCMBCAYVz7CC7eKCKJCC46KYIURx-gXENIauNdyF2hbo7uvqFPYl3-7eOv3rNqeUZFOBKmpyjUNXxfH7hzC-KxuAhMcGEOyc8PUTXL3lqRZIIoaueM44dl8i2PdkLyTyMRi88J1Tfb3WY0mcJqceuRDHbQEZw8BUxDGdZwxULTv8cfAV_QU4sAAAA","v1_Ac3VAozrMM3d8UtgpBf3l7CtN6CLoenpMrAMhwmhpqsTOLRTow"]],[null,null,null,null,null